---
// A framed Mac desktop: menu bar with Tic's menu open and a handful of notes. Everything is sized
// in em off a container-relative font-size, so the composition scales as one picture.
import Note from './Note.astro';
import Icon from './Icon.astro';
import { welcomeTasks, shipTasks, groceryTasks } from '../data/site';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;

const menu: ({ label: string; key?: string; header?: boolean; check?: boolean; sub?: boolean; hot?: boolean } | '-')[] = [
  { label: 'New List', key: '⌘N' },
  '-',
  { label: 'Recent Lists', header: true },
  { label: 'Welcome to Tic 👋' },
  { label: 'Ship v0.4' },
  { label: 'Groceries' },
  { label: 'Reading list' },
  { label: 'Someday' },
  { label: 'More Lists', sub: true },
  '-',
  { label: 'Search Lists…', hot: true },
  { label: 'Settings…', key: '⌘,' },
  '-',
  { label: 'Quit Tic', key: '⌘Q' },
];
---

<div class:list={['scene', cls]}>
  <div
    class="scene-desk desktop"
    role="img"
    aria-label="A Mac desktop with Tic to-do lists floating on it: a welcome checklist, a release checklist with subtasks, a grocery list in glass, two rolled-up lists, and Tic’s menu open in the menu bar."
  >
    <div class="menubar" aria-hidden="true">
      <b>Finder</b><span>File</span><span>Edit</span><span>View</span><span>Go</span><span>Window</span><span>Help</span>
      <span class="grow"></span>
      <span class="glyph">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.6 6.3l1.7 1.7 3.3-3.7M11 6h10M2.6 12.3l1.7 1.7 3.3-3.7M11 12h10M11 18.8h8.5" /><rect x="2.6" y="16.2" width="5.2" height="5.2" rx="1.4" /></svg>
      </span>
      <span>Mon 14 Sep</span><span>9:41</span>
    </div>

    <div class="menu" aria-hidden="true">
      {menu.map((item) =>
        item === '-' ? (
          <div class="sep"></div>
        ) : (
          <div class:list={['item', { header: item.header, hot: item.hot }]}>
            <span class="check">{item.check && <Icon name="check" />}</span>
            <span class="grow">{item.label}</span>
            {item.key && <span class="key">{item.key}</span>}
            {item.sub && <Icon name="caret-right" class="sub" />}
          </div>
        ),
      )}
    </div>

    <Note class="n n-welcome" title="Welcome to Tic 👋" tasks={welcomeTasks} revealed pinned width="21em" />
    <Note class="n n-ship" title="Ship v0.4" color="green" tasks={shipTasks} width="19em" quick={false} />
    <Note class="n n-groceries" title="Groceries" color="blue" material="glass" tasks={groceryTasks} width="16.5em" quickHint />
    <Note class="n n-reading" title="Reading list" color="purple" material="glass" collapsed count={4} width="15.5em" />
    <Note class="n n-someday" title="Someday" color="graphite" material="glass" collapsed count={12} width="15.5em" />
  </div>
</div>

<style>
  .desktop {
    position: relative; aspect-ratio: 16 / 10; overflow: hidden; font-family: var(--sys); text-align: left;
    background: var(--wallpaper); border-radius: 1.2em;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.08), 0 3em 6em -1.5em rgb(20 30 60 / 0.35);
  }

  .menubar {
    display: flex; align-items: center; gap: 1.5em; height: 2.3em; padding: 0 1.4em;
    color: rgb(0 0 0 / 0.85); background: rgb(255 255 255 / 0.28);
    -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);
  }
  .grow { flex: 1; }
  .glyph { display: grid; place-items: center; width: 2.2em; height: 1.75em; border-radius: 0.45em; background: rgb(255 255 255 / 0.35); }
  .glyph svg { width: 1.2em; height: 1.2em; }

  .menu {
    position: absolute; z-index: 5; top: 2.6em; right: 9.5em; width: 17em; padding: 0.4em;
    border-radius: 0.85em; color: rgb(0 0 0 / 0.86); background: rgb(242 242 245 / 0.8);
    -webkit-backdrop-filter: blur(30px) saturate(1.8); backdrop-filter: blur(30px) saturate(1.8);
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.18), inset 0 0 0 0.5px rgb(255 255 255 / 0.6), 0 1em 2.5em rgb(0 0 0 / 0.25);
  }
  .item { display: flex; align-items: center; gap: 0.2em; padding: 0.22em 0.6em 0.22em 0.2em; border-radius: 0.4em; white-space: nowrap; }
  .item.header { font-size: 0.85em; font-weight: 600; opacity: 0.5; }
  .item.hot { color: #fff; background: #0a6cf0; }
  .check { display: grid; place-items: center; width: 1.2em; }
  .item :global(svg) { width: 0.85em; height: 0.85em; }
  .item :global(.sub) { opacity: 0.5; }
  .key { opacity: 0.5; }
  .item.hot .key { opacity: 0.8; }
  .sep { height: 1px; margin: 0.35em 0.6em; background: currentColor; opacity: 0.12; }

  .desktop :global(.n) { position: absolute; }
  .desktop :global(.n-welcome) { left: 4%; top: 9%; }
  .desktop :global(.n-ship) { left: 32%; top: 13%; z-index: 2; }
  .desktop :global(.n-groceries) { left: 52%; top: 44%; z-index: 3; }
  .desktop :global(.n-reading) { left: 32%; top: 64%; }
  .desktop :global(.n-someday) { left: 32%; top: 74%; }
</style>
